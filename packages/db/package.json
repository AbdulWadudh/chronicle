  },
  "dependencies": {
    "@chronicle/config": "workspace:*",
    "@chronicle/shared": "workspace:*",
    "better-auth": "latest",
    "@better-auth/drizzle-adapter": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest"
  }
}
