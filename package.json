{
  "name": "chronicle",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "audit": "bun run scripts/audit.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run audit && bun run lint && turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
