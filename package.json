{
  "name": "chronicle",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:director": "bun --env-file=.env --watch run apps/director/src/index.ts",
    "dev:crew": "bun --env-file=.env --watch run apps/crew/src/index.ts",
    "dev:stage": "bun run --filter @chronicle/stage dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "audit": "bun run scripts/audit.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run audit && bun run lint && turbo run typecheck",
    "ai": "pwsh -NoProfile -File scripts/ai-servers.ps1 -Action start -WithEmbeddings",
    "ai:stop": "pwsh -NoProfile -File scripts/ai-servers.ps1 -Action stop",
    "ai:status": "pwsh -NoProfile -File scripts/ai-servers.ps1 -Action status",
    "ai:logs": "pwsh -NoProfile -File scripts/ai-servers.ps1 -Action logs",
    "app": "pwsh -NoProfile -File scripts/app-servers.ps1 -Action start",
    "app:clear": "pwsh -NoProfile -File scripts/app-servers.ps1 -Action start -Clear",
    "app:stop": "pwsh -NoProfile -File scripts/app-servers.ps1 -Action stop",
    "app:status": "pwsh -NoProfile -File scripts/app-servers.ps1 -Action status",
    "postinstall": "node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js apps/stage/public/static/js"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "^1.4.2",
    "turbo": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
