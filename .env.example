# Local AI services live under G:\AI — see .claude/rules/architecture.md

# llama.cpp server over G:\AI\MODELS\Qwen3.5_9B\*.gguf
LLM_ENDPOINT=http://127.0.0.1:8080/v1
LLM_MODEL=chronicle-llm

# ComfyUI from G:\AI\STABILITY_MATRIX\Data\Packages\ComfyUI
DIFFUSION_ENDPOINT=http://127.0.0.1:8188

# Kokoro-FastAPI, not installed yet
TTS_ENDPOINT=http://127.0.0.1:8880

# RustFS S3-compatible object storage
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=chronicle
STORAGE_SECRET_KEY=chronicle
STORAGE_BUCKET_ASSETS=chronicle-assets

# Dragonfly
REDIS_URL=redis://127.0.0.1:6379

AUTH_SECRET=replace-with-at-least-32-characters-long

# Google Fonts catalogue for the appearance font picker (Web Fonts Developer API).
VITE_GOOGLE_FONTS_API_KEY=

# The owner account for the admin surface. Unset falls back to the first registered user.
AUTH_OWNER_EMAIL=
